<?xml version="1.0" encoding="utf-8"?>
<mujoco model="qube_servo3">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.001" gravity="0 0 -9.82"/>

  <asset>
    <material name="cube_mat" rgba="0.2 0.2 0.2 1"/>
    <material name="arm_mat" rgba="0.5 0.5 0.5 1"/>
    <material name="pendulum_mat" rgba="1.0 0.2 0.2 1"/>
    <material name="joint_mat" rgba="0.3 0.3 0.3 1"/>
    <material name="led" rgba="1.0 0.0 0.0 0.5"/>
    <material name="floor" rgba="1 1 1 1"/>
    <material name="impact_target" rgba="0.0 1.0 0.0 1"/>
  </asset>

  <worldbody>
    <!-- Floor -->
    <geom type="plane" size="1 1 0.05" material="floor" pos="0 0 -0.0001"/>

    <!-- Base fixed to world -->
    <body name="cube" pos="0 0 0.0501">
      <geom type="box"
            size="0.0501 0.0501 0.0501"
            mass="5.0"
            material="cube_mat"/>

      <geom type="box"
            size="0.05011"
            fromto="0 0 0.045 0 0 0.04"
            material="led"/>
    </body>

    <!-- Motor axis body: rotates around z-axis by theta -->
    <body name="motor_axis" pos="0 0 0.123">
      <joint name="theta"
             type="hinge"
             pos="0 0 0"
             axis="0 0 1"
             limited="true"
              range="-2.35619 2.35619"
             damping="0.00001"/>

      <!-- Motor shaft / axis visual, rotates with theta -->
      <geom type="cylinder"
            size="0.011"
            fromto="0 0 -0.0228 0 0 -0.011"
            mass="0.0106"
            material="joint_mat"/>

      <!-- Visual encoder attached to motor axis, negligible mass -->
      <geom type="cylinder"
            size="0.014"
            fromto="-0.019 0 0 0.033 0 0"
            mass="0.000001"
            contype="0"
            conaffinity="0"
            material="pendulum_mat"/>

      <!-- Arm body: connected to motor_axis through alpha hinge -->
      <body name="arm" pos="0 0 0">
        <joint name="alpha"
               type="hinge"
               pos="0 0 0"
               axis="1 0 0"
               damping="0.00001"/>

        <!-- Arm geometry: rotates with alpha -->
        <geom type="cylinder"
              size="0.00325"
              fromto="0.0886 0 0 -0.0215 0 0"
              mass="0.095"
              material="arm_mat"/>

        <!-- Pendulum rigidly attached to the end of the arm -->
        <body name="pendulum" pos="0.08385 0 0">
          <geom type="cylinder"
                size="0.00475"
                fromto="0 0 0.0075 0 0 -0.1215"
                mass="0.024"
                material="pendulum_mat"/>
          <geom
            name="impact_target"
            type="cylinder"
            fromto="0 0 -0.1165 0 0 -0.1215"
            size="0.005"
            mass="0.000001"
            material="impact_target"
            contype="1"
            conaffinity="1"
            solref="0.001 1"
            solimp="0.99 0.999 0.001"
          />
        </body>
      </body>
    </body>

    <!-- Disturbance striker for testing -->
    <body name="striker_body" pos="0.085 0 0.7445">
      <!-- Hinge for striker pendulum -->
      <joint
          name="striker"
          type="hinge"
          axis="1 0 0"
          damping="0.000001"
      />
      <!-- Weightless rod (~1g) -->
      <geom
          name="striker_rod"
          type="cylinder"
          fromto="0 0 0 0 0 -0.5"
          size="0.003"
          mass="0.000001"
        
          material="arm_mat"
      />
      <!-- 200g impact mass -->
      <body name="striker_mass" pos="0 0 -0.5">
          <geom
              name="striker_capsule"
              type="capsule"
              size="0.0125"
              fromto="0.05 0 0 -0.05 0 0"
              mass="0.046"
              material="impact_target"
              contype="1"
              conaffinity="1"
              solref="0.001 1"
              solimp="0.99 0.999 0.001"
          />
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="arm_motor"
           joint="theta"
           gear="1.0"
           ctrlrange="-0.1 0.1"/>
  </actuator>
</mujoco>